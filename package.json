{
  "name": "eleven-bunkers",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace for Eleven Bunkers frontend and backend.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
